---
import MockBrowser from "@/blocks/MockBrowser.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}
const { render = true } = Astro.props;
const html = `
<header><strong>constella<span>✳</span></strong><span>Built for your next idea</span></header>
<main>
  <p class="eyebrow">A SMALL START. AN OPEN SKY.</p>
  <h3>Your next big thing<br>starts right here.</h3>
  <p class="intro">Less setup. More making. A thoughtful foundation for the things you can’t wait to put into the world.</p>
  <a href="#details">Explore what’s possible <span aria-hidden="true">↗</span></a>
  <div class="details" id="details"><span>01 / Make it yours</span><span>HTML + CSS. All you.</span></div>
</main>`;
const css = `
:root { color-scheme: light; }
body { background: #eeeae2; color: #252b23; }
header { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.5rem clamp(1.25rem, 5vw, 4rem); border-bottom: 0.0625rem solid #c9cec0; }
header strong { font-size: 1.25rem; letter-spacing: -0.05em; } header strong span { margin-left: 0.375em; color: #586b32; }
header > span { font-size: 0.75rem; }
main { padding: 2.5rem clamp(1.25rem, 5vw, 4rem) 1.5rem; }
.eyebrow { font-size: 0.625rem; letter-spacing: 0.14em; font-weight: 600; }
h3 { font-family: Georgia, serif; font-weight: 400; font-size: clamp(2.25rem, 6vw, 4rem); line-height: 1.05; letter-spacing: -0.045em; margin: 1.25rem 0; }
.intro { max-width: 48ch; color: #50584a; font-size: 0.875rem; line-height: 1.7; }
a { display: inline-flex; align-items: center; gap: 1.5rem; background: #303f24; color: #fff; border-radius: 100rem; padding: 0.875rem 1.25rem; margin: 0.75rem 0 2rem; font-size: 0.8125rem; text-decoration: none; }
a:hover { background: #455936; } a:focus-visible { outline: 0.125rem solid #303f24; outline-offset: 0.25rem; }
.details { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.75rem; border-top: 0.0625rem solid #c9cec0; padding-top: 1rem; font-size: 0.6875rem; color: #50584a; }
`;
---

<MockBrowser
  {render}
  {html}
  {css}
  address="constella.local"
  label="Constella landing page rendered with HTML and CSS"
/>
