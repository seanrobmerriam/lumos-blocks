---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type WrapperMargin =
  "default" | "0" | "1" | "2" | "3" | "4" | "5" | "6" | "7" | "8" | "auto";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Button layout. */
  variant?: "default" | "stack-to-row";
  /** Top margin. */
  marginTop?: WrapperMargin;
}

const {
  render = true,
  variant = "default",
  marginTop = "default",
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{render && content && (
  <div
    class:list={[
      "button-wrapper",
      variant !== "default" && variant,
      marginTop !== "default" && `margin-top-${marginTop}`,
      className,
    ]}
    {...rest}
  >
    <Fragment set:html={content} />
  </div>
)}

<style is:global>
  @layer components {
    .button-wrapper.stack-to-row {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      @media (width >= 30rem) {
        flex-direction: row;
        align-items: center;
      }
    }
  }
</style>
